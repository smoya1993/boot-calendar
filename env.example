## Server
PORT=4000
NODE_ENV=production

## App (opcional)
# ADMIN=+34123456789

## Webhook externo (n8n) - opcional (si no se define usa el default del código)
# N8N_WEBHOOK_URL=http://127.0.0.1:5678/webhook/add-recipe
# N8N_TIMEOUT_MS=15000

## Twilio (solo si usas WhatsApp/Twilio)
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

## Telegram (solo si habilitas el endpoint de Telegram en tu código)
# TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


